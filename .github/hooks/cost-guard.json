{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "python .github/hooks/session_start.py",
        "bash": "python3 .github/hooks/session_start.py",
        "timeoutSec": 10
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "powershell": "python .github/hooks/cost_guard.py",
        "bash": "python3 .github/hooks/cost_guard.py",
        "timeoutSec": 10
      }
    ]
  }
}
